<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Snitch</RootNamespace>
    <!-- This project sits at the root of the engine tree, so the SDK default
         '**/*.cs' glob would also compile the sibling libraries under
         Libraries/ (and their generated obj files) into Snitch.dll, which
         defines every one of their types twice. They are separate projects. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Libraries/**</DefaultItemExcludes>
  </PropertyGroup>

