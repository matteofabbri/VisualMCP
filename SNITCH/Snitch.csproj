  <!-- Scaffold documents (license texts, CI workflows, CONTRIBUTING) are embedded, not copied:
       they must be readable by the MCP server from any working directory and survive trimming,
       single-file publish and Native AOT. LogicalName is pinned to the flat file name so the
       lookup in TemplateCatalog does not depend on the OS path separator. -->
  <ItemGroup>
    <EmbeddedResource Include="Scaffolding/Templates/*" LogicalName="Snitch.Scaffolding.Templates.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Compile-time only: BinaryLogReplayEventSource lives in Microsoft.Build, and at run time the
         assembly is the SDK's (MSBuildLocator). Copying it to the output folder would make
         MSBuildLocator refuse to register, which is why runtime assets are excluded. 17.7.2 is the
         newest cached version whose assets target a .NET TFM this project can consume. -->
    <PackageReference Include="Microsoft.Build" Version="17.7.2" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Tasks.Core" Version="18.11.0" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
    <PackageReference Include="Microsoft.NET.StringTools" Version="18.11.0" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageReference Include="Microsoft.Build.Locator" Version="1.11.2" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
